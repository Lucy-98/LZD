# ==========================================================================
# Nhung gi KHONG duoc gui sang Docker daemon khi build.
#
# Truoc khi co file nay: build context = 549 MB (chu yeu la CSV trong data/),
# nhan voi 3 image = ~1.6 GB truyen di moi lan build, va moi thay doi trong
# data/ deu lam invalidate cache.
# Sau khi co: ~1 MB.
#
# data/ van duoc dung luc RUNTIME qua bind mount (xem docker-compose.yml),
# khong can nam trong image.
# ==========================================================================

# --- du lieu (bind mount luc runtime, khong bake vao image)
data/
*.csv
*.parquet
*.duckdb
*.duckdb.wal
lakehouse/

# --- source/runtime mounts
# Repo nam trong OneDrive; cac file nay co the la reparse point lam BuildKit
# fail "invalid file request". Compose van bind mount chung luc runtime.
src/
config/
dbt/
airflow/
sql/

# --- chi dua artifact notebook can cho serving vao image
# Model la mot phan cua image: doi model = build/tag/deploy image moi.
models/*
!models/uplift_voucher/
models/uplift_voucher/*
!models/uplift_voucher/model_booster.txt
!models/uplift_voucher/feature_contract.json
!models/uplift_voucher/metadata.json

# --- tai lieu
docs/
*.md
!README.md

# --- state cua runtime
.tmp/
airflow/logs/
dbt/target/
dbt/logs/
dbt/dbt_packages/
logs/

# --- python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- git / IDE / OS
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- secret: khong bao gio bake .env vao image
.env
.env.*
!.env.example

# --- file cua chinh docker (khong can trong context)
docker-compose*.yml
Makefile
scripts/stack.ps1
tests/
requirements-dev.txt
