# ==========================================================================
# LZD Uplift Feature Platform - environment
#
# FILE NAY LA TUY CHON. Moi bien duoi day da co gia tri mac dinh y het trong
# `docker-compose.yml`, nen `docker compose up -d` chay duoc khi khong co
# `.env`. Chi copy thanh `.env` khi can GHI DE (doi port bi trung, doi mat
# khau, bat DAG tu dong):
#   Copy-Item .env.example .env
# ==========================================================================

COMPOSE_PROJECT_NAME=lzd-uplift
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# --------------------------------------------------------------- Postgres
POSTGRES_USER=lzd
POSTGRES_PASSWORD=lzd_secret
POSTGRES_DB=lzd
POSTGRES_PORT=5432

# ----------------------------------------------------------------- Airflow
# UID cua user chay container. Tren Windows/Docker Desktop giu 50000.
AIRFLOW_UID=50000
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Fernet key: sinh moi bang
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__WEBSERVER__SECRET_KEY=lzd-airflow-secret
# DAG bat san ngay khi stack len (cach nhau bang dau cach). De trong = tat ca
# DAG deu paused, phai vao UI bat tay - do la mac dinh, vi bootstrap doc file
# CSV 476 MB, khong nen tu chay khi ai do vua `docker compose up` de xem thu.
#   30_train_uplift_model  -> bat vong train hang tuan (03:00 thu Hai)
# AIRFLOW_UNPAUSE_DAGS=30_train_uplift_model

# ------------------------------------------------------------------- Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC_EVENTS=app.user.events.v1
KAFKA_TOPIC_DLQ=app.user.events.dlq.v1
KAFKA_CONSUMER_GROUP=feature-stream-consumer
KAFKA_UI_PORT=8082

# ------------------------------------------------------------------- MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_LAKE=lakehouse
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_MLFLOW=mlflow

# ------------------------------------------------------------------- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=512mb
REDISINSIGHT_PORT=5540

# ------------------------------------------------------------------ MLflow
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=uplift-descn

# ------------------------------------------------------------ Inference API
INFERENCE_API_PORT=8000
INFERENCE_WORKERS=1
# Nguong uplift de quyet dinh phat voucher (teammate se tune lai)
UPLIFT_DECISION_THRESHOLD=0.0070347543

# ------------------------------------------------------------ Observability
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
LOKI_PORT=3100

# ----------------------------------------------------------- Feature store
# So shard khi sync DuckDB -> Redis (idempotent, resume theo shard)
FEATURE_SYNC_SHARDS=32
FEATURE_SYNC_BATCH_SIZE=1000
# Giu lai bao nhieu version cu trong Redis truoc khi GC
FEATURE_VERSIONS_TO_KEEP=2
# TTL cho key cua version KHONG active (giay). Active version khong co TTL.
FEATURE_STALE_TTL_SECONDS=86400
# TTL cho realtime overlay tu Kafka (giay)
REALTIME_OVERLAY_TTL_SECONDS=3600
# Ty le sample khi validate offline vs online
FEATURE_VALIDATION_SAMPLE=500

# ------------------------------------------------------------ Event producer
# So event/giay ma simulator ban vao Kafka
PRODUCER_EVENTS_PER_SECOND=25
PRODUCER_USER_POOL=20000
# Ty le event bi loi co y (de test DLQ / data quality). 0.0 = tat.
PRODUCER_CORRUPT_RATE=0.01

# --------------------------------------------------------------- Lakehouse
DUCKDB_PATH=/opt/lakehouse/warehouse.duckdb
LAKE_ROOT=s3://lakehouse
